# Default: works offline, no key needed. Start with npm start.
MODEL_MODE=offline
# For remote: MODEL_MODE=remote, set MODEL_ID and MODEL_API_KEY.
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_ID=your-provider-supported-model
# MODEL_API_KEY=your-secret-key
# MODEL_FORMAT=json_schema
# PORT=8787
# DATA_FILE=.data/state.json

# V0.9 knowledge understanding model (independent of the mnemonic generation model).
# Offline baseline is deterministic and does not provide deep semantic understanding.
KNOWLEDGE_MODEL_MODE=offline
# For a real OpenAI-compatible model provider:
# KNOWLEDGE_MODEL_MODE=remote
# KNOWLEDGE_MODEL_BASE_URL=https://api.openai.com/v1
# KNOWLEDGE_MODEL_ID=your-provider-supported-model
# KNOWLEDGE_MODEL_API_KEY=your-secret-key
# KNOWLEDGE_MODEL_FORMAT=json_schema
